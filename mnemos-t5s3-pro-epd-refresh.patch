+void pushFrames(
+    int color,
+    uint16_t count) {
+
+    for (uint16_t i = 0; i < count; ++i) {
+        epd_push_pixels(
+            epd_full_screen(),
+            PUSH_TIME,
+            color);
+    }
+}
