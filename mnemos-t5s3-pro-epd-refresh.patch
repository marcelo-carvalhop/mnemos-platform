+bool sameScreen(
+    const char* key) {
+
+    if (!key) {
+        key = "";
+    }
+
+    return
+        std::strncmp(
+            gEngine.lastScreen,
+            key,
+            sizeof(gEngine.lastScreen) - 1U) == 0;
+}
+
+void rememberScreen(
+    const char* key) {
+
+    std::strncpy(
+        gEngine.lastScreen,
+        key ? key : "",
+        sizeof(gEngine.lastScreen) - 1U);
+
+    gEngine.lastScreen[
+        sizeof(gEngine.lastScreen) - 1U] = '\0';
 }
 
 
