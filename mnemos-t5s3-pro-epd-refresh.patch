+// ---------------------------------------------------------------
+// E-paper ED047TC1: motor de refresh anti-ghosting.
+// Política, medições e roteiro de ajuste: docs/EPD_REFRESH.md.
+// ---------------------------------------------------------------
+
+// VCOM do painel em mV (valor absoluto, -1,56 V => 1560).
+// Se a flex do painel trouxer um VCOM impresso, use-o aqui.
+constexpr uint16_t EPD_VCOM_MV = 1560;
+
+// Clock de pixel do periférico LCD (MHz). 0 mantém o padrão do epdiy.
+// 10 MHz => quadro de ~14 ms (~70 Hz), próximo do timing nominal
+// de controladores e-ink. Underrun na fila de linhas reduz o clock
+// pela metade automaticamente, até o mínimo abaixo.
+constexpr uint8_t EPD_LCD_PIXEL_CLOCK_MHZ = 10;
+constexpr uint8_t EPD_LCD_PIXEL_CLOCK_MIN_MHZ = 4;
+
+// Tempo de acionamento de uma excursão completa preto<->branco
+// a 25 °C. É convertido em quadros pelo período de quadro medido
+// no próprio hardware (o driver LCD do epdiy ignora phase_times).
+constexpr uint16_t EPD_SATURATION_DRIVE_MS = 360;
+
+// Piso e teto, em quadros, de uma excursão completa.
+// O GC16 embutido do epdiy entregava apenas 15.
+constexpr uint8_t EPD_MIN_SATURATION_FRAMES = 20;
+constexpr uint8_t EPD_MAX_SATURATION_FRAMES = 60;
+
+// Pares escuro/claro de impulso nulo que soltam as partículas
+// antes da transição principal.
+constexpr uint8_t EPD_CLEAN_AGITATION_PAIRS = 2;
+constexpr uint8_t EPD_PARTIAL_AGITATION_PAIRS = 1;
+
+// Quadros neutros (0 V) ao final de cada update: nenhum pixel
+// fica retendo tensão no capacitor de armazenamento.
+constexpr uint8_t EPD_SETTLE_FRAMES = 1;
+
+// true: troca de tela faz preto -> branco pleno -> destino.
+// ~40% mais lento; pretos e cinzas mais uniformes.
+constexpr bool EPD_CLEAN_EXTRA_WHITE_PASS = false;
+
+// Atualização parcial (sem flash, só pixels alterados) apenas
+// na mesma tela, com poucos pixels alterados numa região pequena.
+// Troca de tela sempre usa a transição completa com flash.
+constexpr uint16_t EPD_PARTIAL_MAX_CHANGED_PERMILLE = 30;
+constexpr uint8_t EPD_PARTIAL_MAX_AREA_PERCENT = 30;
+constexpr uint8_t EPD_MAX_CONSECUTIVE_PARTIALS = 10;
+
+// Limpeza profunda automática (ciclos preto/branco balanceados)
+// a cada N trocas de tela com flash. 0 desativa.
+constexpr uint16_t EPD_AUTO_DEEP_CLEAN_INTERVAL = 20;
+constexpr uint8_t EPD_DEEP_CLEAN_CYCLES = 2;
+constexpr uint8_t EPD_BOOT_CLEAN_CYCLES = 1;
+
+// Temperatura: termistor do TPS65185 quando plausível; senão a
+// temperatura do gauge BQ27220; senão o valor padrão.
+constexpr bool EPD_USE_PMIC_THERMISTOR = true;
+constexpr uint32_t EPD_TEMPERATURE_REFRESH_MS = 5U * 60U * 1000U;
+constexpr int8_t EPD_DEFAULT_TEMPERATURE_C = 25;
 
 // Energia do terminal. Também vale no build bench.
 constexpr uint32_t AUTO_POWER_OFF_IDLE_MS = 10U * 60U * 1000U;
diff --git a/firmware/t5s3-pro/include/epd_waveform_builder.h b/firmware/t5s3-pro/include/epd_waveform_builder.h
new file mode 100644
index 0000000..03908b1
--- /dev/null
+++ b/firmware/t5s3-pro/include/epd_waveform_builder.h
@@ -0,0 +1,156 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+/*
+ * Gerador de waveforms do Mnemos para o ED047TC1 (T5S3 Pro).
+ *
+ * Por que existe:
+ *
+ *   O waveform embutido do epdiy para o ED047TC1 foi gerado para o
+ *   driver I2S, no qual cada fase tem duração própria (phase_times).
+ *   No ESP32-S3 o epdiy usa o periférico LCD e ignora phase_times:
+ *   todos os quadros têm a mesma duração. O GC16 embutido entrega
+ *   então apenas 15 quadros curtos por excursão preto<->branco,
+ *   insuficiente para saturar as partículas. O resultado é o
+ *   "fantasma" forte da tela anterior.
+ *
+ * O que este módulo faz:
+ *
+ *   Gera, em tempo de execução, tabelas no formato EpdWaveformPhases
+ *   (fase x destino x origem, 2 bits por pixel) com:
+ *
+ *   - número de quadros de saturação N calculado a partir do período
+ *     real de quadro medido no hardware e da temperatura;
+ *   - balanço DC exato: o impulso líquido de qualquer transição
+ *     f -> t é Phi(t) - Phi(f), com Phi(l) = levelFrames(l, N).
+ *     Qualquer ciclo de telas soma zero e o DC acumulado no
+ *     pixel fica limitado;
+ *   - "agitação" (pares escuro/claro de impulso líquido nulo) que
+ *     solta as partículas antes da transição principal;
+ *   - quadros finais neutros (0 V), para que nenhum pixel fique
+ *     retendo tensão no capacitor de armazenamento após o update;
+ *   - compactação: quadros em que nenhum par (origem, destino)
+ *     presente na imagem recebe tensão são removidos.
+ *
+ * Não depende de Arduino nem do epdiy: é testável no host
+ * (ver test/epd_waveform_builder_test.cpp).
+ */
+
+namespace EpdWaveformBuilder {
+
+constexpr uint8_t OP_NONE = 0;
+constexpr uint8_t OP_DARKEN = 1;
+constexpr uint8_t OP_LIGHTEN = 2;
+
+constexpr uint8_t LEVELS = 16;
+constexpr uint8_t WHITE_LEVEL = 15;
+
+// Bytes por fase: 16 destinos x 16 origens x 2 bits.
+constexpr size_t BYTES_PER_PHASE = 64;
+
+// epdiy guarda o número de fases em uint8_t.
+constexpr uint16_t MAX_PHASES = 250;
+
+constexpr uint8_t MIN_SATURATION_FRAMES = 4;
+constexpr uint8_t MAX_SATURATION_FRAMES = 72;
+constexpr uint8_t MAX_AGITATION_PAIRS = 8;
+constexpr uint8_t MAX_SETTLE_FRAMES = 4;
+
+constexpr size_t MAX_LUT_BYTES =
+    static_cast<size_t>(MAX_PHASES) * BYTES_PER_PHASE;
+
+enum class Kind : uint8_t {
+    /*
+     * Atualização com flash, aplicada a TODOS os pixels do painel
+     * (inclusive os que não mudaram):
+     *
+     *   agitação -> escurece proporcional à origem (todos chegam ao
+     *   preto juntos) -> clareia proporcional ao destino.
+     *
+     * Com extraWhitePass:
+     *
+     *   agitação -> preto -> branco pleno -> escurece até o destino.
+     *
+     * Elimina o histórico de todos os pixels; é a transição usada
+     * em troca de tela.
+     */
+    Clean,
+
+    /*
+     * Atualização sem flash, apenas pixels que mudaram
+     * (origem == destino é sempre no-op):
+     *
+     *   clareia até o branco (proporcional à origem) e escurece até
+     *   o destino. Transições puramente preto/branco ocupam um único
+     *   bloco de N quadros. Também é o desenho "a partir do branco"
+     *   depois de uma limpeza profunda.
+     */
+    Direct,
+};
+
+struct Params {
+    Kind kind = Kind::Clean;
+    uint8_t saturationFrames = 20;
+    uint8_t agitationPairs = 0;
+    uint8_t settleFrames = 1;
+    bool extraWhitePass = false;
+};
+
+// Conjunto de pares presentes; índice = (destino << 4) | origem,
+// exatamente o byte do difference image do epdiy.
+struct PairSet {
+    uint8_t bits[32] = {};
+
+    void clear();
+    void addAll();
+    void add(uint8_t interlacedByte) {
+        bits[interlacedByte >> 3] |=
+            static_cast<uint8_t>(1U << (interlacedByte & 7U));
+    }
+    bool contains(uint8_t interlacedByte) const {
+        return (bits[interlacedByte >> 3] >> (interlacedByte & 7U)) & 1U;
+    }
+    bool empty() const;
+};
+
+inline uint8_t pairIndex(uint8_t from, uint8_t to) {
+    return static_cast<uint8_t>(((to & 0x0FU) << 4) | (from & 0x0FU));
+}
+
+// Phi(l): quadros de saturação equivalentes ao nível l (0 = preto).
+uint8_t levelFrames(uint8_t level, uint8_t saturationFrames);
+
+// Número de quadros antes da compactação e dos quadros neutros.
+uint16_t rawFrameCount(const Params& params);
+
+// Operação (OP_*) do par no quadro bruto `frame`.
+uint8_t rawOp(
+    const Params& params,
+    uint16_t frame,
+    uint8_t from,
+    uint8_t to);
+
+/*
+ * Gera a tabela compactada em `out`.
+ *
+ * used == nullptr considera todos os 256 pares.
+ * Retorna o número de fases (0 se os parâmetros forem inválidos ou
+ * a capacidade insuficiente). Se nenhum par usado exigir tensão,
+ * retorna apenas os quadros neutros (ou 0 se settleFrames == 0).
+ */
+uint16_t build(
+    const Params& params,
+    const PairSet* used,
+    uint8_t* out,
+    size_t capacity);
+
+// Lê a operação de uma tabela gerada (para testes/diagnóstico).
+uint8_t opAt(
+    const uint8_t* luts,
+    uint16_t phase,
+    uint8_t from,
+    uint8_t to);
+
+}  // namespace EpdWaveformBuilder
