# Copy to .env and fill in. Never commit .env (§11.7).
#   cp .env.example .env

# --- host ports -------------------------------------------------------------
# Defaults chosen to avoid colliding with other local stacks.
POSTGRES_PORT=5435
SERVER_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- postgres ---------------------------------------------------------------
# Major version is pinned and identical in dev, CI and production (§11.7):
# SKIP LOCKED, row-level security and the migration tests all need to run
# against the version actually shipped.
POSTGRES_USER=flashcards
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=flashcards

# --- object storage ---------------------------------------------------------
# MinIO locally; any S3-compatible endpoint in production (§7.2).
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-locally
S3_BUCKET=uploads
S3_REGION=us-east-1

# --- application ------------------------------------------------------------
ENVIRONMENT=development
# Swagger UI is served in development and disabled in production (§4.3).
ENABLE_DOCS=true
LOG_LEVEL=INFO

# --- model ------------------------------------------------------------------
# Lives only in the server and worker environment. Never in the client, never
# in an image layer, never in the repository (§11.7).
ANTHROPIC_API_KEY=
