    "content": {
      "prompt": {
        "format": "plain",
        "text": "O que ocorre no three-way handshake do TCP?"
      },
      "answer": {
        "format": "plain",
        "text": "Cliente e servidor trocam SYN, SYN-ACK e ACK para sincronizar números de sequência e estabelecer a conexão."
      }
