    "type": "basic",
    "content": {
      "prompt": {
        "format": "plain",
        "text": "Qual é a diferença fundamental entre TCP e UDP?"
      },
      "answer": {
        "format": "plain",
        "text": "TCP fornece um fluxo orientado a conexão, confiável e ordenado; UDP fornece datagramas sem conexão e sem garantias de entrega ou ordem."
      }
    },
    "tags": [
      "redes-de-computadores"
