{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemos.dev/schema/deck/v1.json",
  "title": "Mnemos Deck v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "metadata"
  ],
  "properties": {
    "schema": {
      "const": "mnemos.deck/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updatedAt",
        "revision"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
