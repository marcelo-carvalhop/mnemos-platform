# Copied to /opt/mnemos/deploy/lightsail/.env on the server, chmod 600.
# Never committed. Generate secrets with: openssl rand -base64 48

DOMAIN=mnemos.<ip-with-dashes>.sslip.io

# --- postgres (container on the same instance) -----------------------------
POSTGRES_USER=mnemos
POSTGRES_PASSWORD=
POSTGRES_DB=mnemos
DATABASE_URL=postgresql+psycopg://mnemos:<POSTGRES_PASSWORD>@postgres:5432/mnemos

# --- object storage (Lightsail bucket) --------------------------------------
S3_ENDPOINT_URL=https://s3.us-east-2.amazonaws.com
S3_PUBLIC_ENDPOINT_URL=https://s3.us-east-2.amazonaws.com
S3_REGION=us-east-2
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- application -----------------------------------------------------------
# Staging, not production: production refuses to boot without device
# attestation (§8.1), which the app does not implement yet.
ENVIRONMENT=staging
LOG_LEVEL=INFO
ENABLE_DOCS=false
JWT_SECRET=
REQUIRE_ATTESTATION=false
# Empty on purpose: without attestation anyone can mint anonymous accounts,
# and each would get a free generation on this key.
ANTHROPIC_API_KEY=

# --- invite-only signup -----------------------------------------------------
# Staging admits only invited people: the code is required to create an
# account, the emailed link to sign in. Gmail with an app password (2-step
# verification on): SMTP_USER is the address, SMTP_PASSWORD the 16-letter app
# password.
# Beta: accounts with an email generate cards without a quota. Cap the
# spend in the Anthropic console.
BETA_UNLIMITED_GENERATION=false
INVITE_CODE=
REQUIRE_EMAIL_VERIFICATION=true
PUBLIC_WEB_URL=https://mnemos.<ip-com-hífens>.sslip.io
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
