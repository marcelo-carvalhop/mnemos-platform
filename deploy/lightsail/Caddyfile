# One origin for everything, with a Let's Encrypt certificate.
#   /v1/*, /healthz  -> API (mobile app and terminal use the bare host)
#   /api/*           -> API with the prefix stripped (the web build calls /api,
#                       as the ng serve proxy does in development)
#   everything else  -> Angular build, falling back to index.html for routes
#
# DOMAIN is the site's address. LEGACY_DOMAIN is the address it had before
# (the sslip.io one): apps and terminals already paired keep calling its API,
# and a redirect would break them — a client re-sending a POST with its body
# after a 308 is not something to count on — so the API still answers there,
# and only the pages move to the new address. www goes to the bare domain.

(site) {
	encode zstd gzip

	# Registros de acesso por 6 meses: o Marco Civil (art. 15) exige, e a
	# política de privacidade (/privacidade) promete exatamente isso. Ficam no
	# volume caddy-data. Caddy já mascara Authorization e cookies; o token do
	# link de confirmação vai na query de /confirmar e é mascarado aqui.
	log {
		output file /data/logs/access.log {
			roll_size 50MiB
			roll_keep 1000
			roll_keep_for 4392h
		}
		format filter {
			request>uri query {
				replace token REDACTED
			}
		}
	}

	handle_path /api/* {
		reverse_proxy server:8000
	}

	@api path /v1/* /healthz
	handle @api {
		reverse_proxy server:8000
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

{$DOMAIN} {
	import site
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} 308
}

{$LEGACY_DOMAIN} {
	@pages not path /v1/* /healthz /api/*
	redir @pages https://{$DOMAIN}{uri} 308
	import site
}
